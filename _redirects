# Hearth redirect rules. Netlify reads top to bottom.

# Internal docs (docs/, incl. docs/legal) and theme build tools (themes/) are not published: always 404,
# even though the SPA fallback below would otherwise answer 200.
/docs    /docs-not-published  404!
/docs/*  /docs-not-published  404!
/themes    /themes-not-published  404!
/themes/*  /themes-not-published  404!

# Pretty path for the app — both /app and /app/ serve the app
/app    /app/index.html  200

# SPA fallback for the app's internal routes
/app/*  /app/index.html  200

# Everything else: serve index.html for unknown paths (SPA-friendly)
/*      /index.html      200
